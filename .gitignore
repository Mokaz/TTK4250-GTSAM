# OS metadata
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# Python bytecode and native extensions
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments and local secrets
.venv/
venv/
/env/
.env
.env.*
!.env.example

# Tests, coverage, and tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/
.nox/
.cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Packaging
/build/
/dist/
*.egg-info/

# Notebooks
.ipynb_checkpoints/

# Local editor and assistant settings
.idea/
.claude/settings.local.json

# Generated SLAM outputs.
# Unanchored so this also catches assignment/runs/ and src/master_code/runs/,
# not just the one at the repo root.
**/runs/*
!**/runs/.gitkeep
**/videos/*
!**/videos/.gitkeep

# The student handout is generated, never written by hand:
#     cd assignment && python tools/make_handout.py --out ../handout
# It is ~12 MB because make_handout copies data/ into it, and a committed copy
# can silently drift from assignment/, which is the one thing the generator
# exists to prevent. Build a zip at release time instead of tracking it.
/handout/

# The zip students upload, if create_handin.py is run inside the repo
handin_*.zip

# LaTeX build output. latexmk is pointed at build/, but keep the extensions
# too, for anyone compiling in place or from an editor.
latex/**/build/
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.lof
*.lot
*.nav
*.out
*.run.xml
*.snm
*.synctex.gz
*.toc
*.vrb
*.xdv

